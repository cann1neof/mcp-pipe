{
  "name": "mcp-pipe",
  "version": "1.0.0",
  "description": "Cross-MCP memory for AI tool calls: every result is saved, passed to other tools by reference, reshaped with jq, patched and re-run, or chained into pipes",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-pipe": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cann1neof/mcp-pipe.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "ai",
    "llm",
    "tokens"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "bench": "tsx bench/run.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "tsx bench/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.1.1",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "homepage": "https://cann1neof.github.io/mcp-pipe/",
  "bugs": {
    "url": "https://github.com/cann1neof/mcp-pipe/issues"
  }
}
